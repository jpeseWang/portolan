# .sdw/env.sh — generated by `sdw-toolchain --emit-env`; sourced by hooks, bins and the Bash tool (bash or zsh).
# Only comments and export lines: no commands, no output, safe under `set -u`.
export PATH="$HOME/.nvm/versions/node/v22.12.0/bin:$PATH"
export DOTNET_ROOT="$HOME/.dotnet"
export PATH="$HOME/.dotnet:$PATH"
export PATH="/absolute/projdir/.sdw/state/corepack-bin:$PATH"
