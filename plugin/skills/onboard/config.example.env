# .sdw/config.env — read by sdw-cfg. KEY=value, no expansion, last one wins.
# No secrets: tokens live in Keychain (sdw:jira:<base url>, sdw:figma, sdw:<PROJ_SLUG>:<role>).

BASE_BRANCH=main
# github | gitlab | bitbucket | azure | none (no remote)
VCS_HOST=github
# none | jira | github
TRACKER=none
# the repo's own skills sdw defers to: commit push start-work create-branch create-mr review-pr create-ticket daily-report logwork
TEAM_SKILLS=
# Keychain namespace; default: projdir basename, lowercased
PROJ_SLUG=
# placeholders {key} {n} {slug}
BRANCH_PATTERN={key}-{slug}
# placeholders {key} {n} {summary}
PR_TITLE_PATTERN={key}: {summary}

# Jira site root without a trailing slash
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_PROJECT=
# cloud (REST v3) | dc (REST v2)
JIRA_FLAVOR=cloud
# basic | bearer; empty = basic for cloud, bearer for dc
JIRA_AUTH=
# customfield ids
JIRA_AC_FIELD=
JIRA_SPRINT_FIELD=
# transition ids; empty = never transition
TRANSITION_IN_PROGRESS=
TRANSITION_IN_REVIEW=

# GitHub Projects: <owner>/<number> and field/option ids from `gh project field-list`
GH_PROJECT=
GH_STATUS_FIELD_ID=
GH_STATUS_IN_PROGRESS_ID=
GH_STATUS_IN_REVIEW_ID=

# 1 enables /sdw:logwork
WORKLOG=0
# projdir-relative local docs dir; empty = none
DOCS_DIR=
# 1 only when the database host is local
DB_LOCAL=0
FIGMA_FILE_KEY=
# Figma MCP calls per month allowed; 0 = REST renders only
FIGMA_MCP_BUDGET=0
