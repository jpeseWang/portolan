#!/usr/bin/env python3
"""usage: sdw-ui-diff <design.png> <app.png> --out <prefix> [--threshold N] [--cell N]
                   [--min-ratio F] [--top N] [--key ROUTE] [--path P]... [--no-evidence]

Writes <prefix>.side-by-side.png, .overlay.png and .heatmap.png, prints the mismatch share
and the grid cells that differ most in app pixels, and records an evidence entry (kind ui-diff).
The design is scaled to the app's width: capture at the artboard size, DPR 1.

Exit: 0 compared (a mismatch is information, not failure), 2 usage, 4 Pillow or input missing.
"""

import argparse
import os
import subprocess
import sys
from pathlib import Path

ME = "sdw-ui-diff"
PAD_COLOUR = (255, 0, 255)


def fail(code, msg):
    print(f"{ME}: {msg}", file=sys.stderr)
    sys.exit(code)


try:
    from PIL import Image, ImageChops, ImageDraw
except ImportError:
    if "-h" in sys.argv or "--help" in sys.argv:
        print(__doc__)
        sys.exit(0)
    fail(4, "needs Pillow: python3 -m pip install Pillow")


def load(path):
    try:
        return Image.open(path).convert("RGB")
    except (OSError, ValueError) as err:
        fail(4, f"cannot read {path}: {err}")


def match_width(design, width):
    if design.width == width:
        return design
    return design.resize((width, round(design.height * width / design.width)), Image.LANCZOS)


def pad_to(img, height):
    if img.height == height:
        return img
    canvas = Image.new("RGB", (img.width, height), PAD_COLOUR)
    canvas.paste(img, (0, 0))
    return canvas


def mismatch_mask(a, b, threshold):
    return ImageChops.difference(a, b).convert("L").point(lambda v: 255 if v > threshold else 0)


def region_report(mask, cell, min_ratio, limit):
    regions = []
    for top in range(0, mask.height, cell):
        for left in range(0, mask.width, cell):
            box = (left, top, min(left + cell, mask.width), min(top + cell, mask.height))
            area = (box[2] - box[0]) * (box[3] - box[1])
            ratio = mask.crop(box).histogram()[255] / area if area else 0
            if ratio >= min_ratio:
                regions.append((ratio, box))
    regions.sort(reverse=True)
    return regions[:limit]


def heatmap(app, mask):
    dimmed = Image.blend(app, Image.new("RGB", app.size, (255, 255, 255)), 0.6)
    return Image.composite(Image.new("RGB", app.size, (230, 30, 30)), dimmed, mask)


def side_by_side(*panels):
    gap = 16
    canvas = Image.new("RGB", (sum(p.width for p in panels) + gap * (len(panels) - 1),
                               max(p.height for p in panels)), (240, 240, 240))
    x = 0
    for panel in panels:
        canvas.paste(panel, (x, 0))
        x += panel.width + gap
    return canvas


class Parser(argparse.ArgumentParser):
    def error(self, message):
        print(__doc__, file=sys.stderr)
        fail(2, message)


def record(args, pct, artifacts):
    cmd = [os.path.join(os.path.dirname(os.path.abspath(sys.argv[0])), "sdw-evidence"), "add", "--kind", "ui-diff",
           "--key", args.key or args.app.name, "--result", "info", "--detail", f"mismatch={pct}"]
    for p in args.path or ["."]:
        cmd += ["--path", p]
    for a in artifacts:
        cmd += ["--artifact", a]
    try:
        rc = subprocess.run(cmd, stdout=subprocess.DEVNULL).returncode
    except OSError as err:
        rc = f"sdw-evidence unavailable: {err}"
    if rc != 0:
        print(f"{ME}: evidence not recorded ({rc})", file=sys.stderr)


def main():
    parser = Parser(prog=ME, usage=__doc__.split("\n\n")[0], add_help=False)
    parser.add_argument("-h", "--help", action="store_true")
    parser.add_argument("design", type=Path, nargs="?")
    parser.add_argument("app", type=Path, nargs="?")
    parser.add_argument("--out", type=Path)
    parser.add_argument("--threshold", type=int, default=40)
    parser.add_argument("--cell", type=int, default=64)
    parser.add_argument("--min-ratio", type=float, default=0.08)
    parser.add_argument("--top", type=int, default=12)
    parser.add_argument("--key")
    parser.add_argument("--path", action="append")
    parser.add_argument("--no-evidence", action="store_true")
    args = parser.parse_args()
    if args.help:
        print(__doc__)
        return 0
    if not (args.design and args.app and args.out):
        parser.error("design, app and --out are required")
    if args.cell < 1 or not 0 <= args.threshold <= 255:
        parser.error("--cell >= 1 and --threshold 0-255")
    for p in (args.design, args.app):
        if not p.is_file():
            fail(4, f"missing input {p}")

    app = load(args.app)
    design = match_width(load(args.design), app.width)
    height = max(app.height, design.height)
    if abs(app.height - design.height) > 2:
        print(f"height differs: design {design.height}px vs app {app.height}px "
              f"(magenta = area only one of them has)")
    app_p, design_p = pad_to(app, height), pad_to(design, height)

    mask = mismatch_mask(design_p, app_p, args.threshold)
    pct = f"{mask.histogram()[255] / (mask.width * mask.height):.1%}"
    print(f"mismatch: {pct} of pixels differ by more than {args.threshold}/255")

    args.out.parent.mkdir(parents=True, exist_ok=True)
    heat = heatmap(app_p, mask)
    regions = region_report(mask, args.cell, args.min_ratio, args.top)
    draw = ImageDraw.Draw(heat)
    for _, (x0, y0, x1, y1) in regions:
        draw.rectangle((x0, y0, x1 - 1, y1 - 1), outline=(0, 90, 255), width=2)
    outputs = {
        "side-by-side": side_by_side(design_p, app_p, heat),
        "overlay": Image.blend(design_p, app_p, 0.5),
        "heatmap": heat,
    }
    written = []
    for name, img in outputs.items():
        path = args.out.with_name(f"{args.out.name}.{name}.png").resolve()
        img.save(path)
        written.append(str(path))
        print(f"wrote {path}")

    if regions:
        print(f"\nregions that differ most (app px, {args.cell}px cells):")
        for ratio, (x0, y0, x1, y1) in regions:
            print(f"  x {x0:>5}-{x1:<5} y {y0:>5}-{y1:<5} {ratio:5.0%}")
    else:
        print("no region above the reporting floor")

    if not args.no_evidence:
        record(args, pct, written)
    return 0


if __name__ == "__main__":
    sys.exit(main())
