#!/usr/bin/env bash
# Keep .sdw/, e2e/.auth/, playwright/.auth/ and .claude/settings.local.json out of every repo's git status via .git/info/exclude (never .gitignore).
set -u

usage() {
  cat <<'EOF'
usage: sdw-exclude [--remove|--check] [--legacy] [repo-dir...]
  default      write or refresh the sdw block in <common-dir>/info/exclude
  --remove     remove the sdw block
  --check      exit 1 if any repo lacks the block
  --legacy     also remove the v1 "Solo Dev Workflow" block
  repo-dir...  defaults to every repo from sdw-workdir --repos
exit: 0 ok, 1 block missing (--check), 2 usage, 3 not onboarded, 4 not a git repo
EOF
}

here=$(cd "$(dirname "$0")" && pwd -P)
MODE=write LEGACY=0
DIRS=()
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --remove) MODE=remove ;;
    --check) MODE=check ;;
    --legacy) LEGACY=1 ;;
    -*) usage >&2; exit 2 ;;
    *) DIRS+=("$1") ;;
  esac
  shift
done

if [ ${#DIRS[@]} -eq 0 ]; then
  list=$("$here/sdw-workdir" --repos) || exit $?
  while IFS= read -r d; do [ -n "$d" ] && DIRS+=("$d"); done <<EOF
$list
EOF
fi

BEGIN='# >>> sdw >>>'
END='# <<< sdw <<<'
BLOCK="$BEGIN
.sdw/
e2e/.auth/
playwright/.auth/
.claude/settings.local.json
$END"
V1_HEAD='# Solo Dev Workflow — never commit these'
V1_PATS='config.env .mcp.json .claude/settings.local.json .claude/task-state.json .auth.json *.auth.json shots/ AGENTS.md CLAUDE.md TASKS.md CHANGELOG.md config.env.example .mcp.json.example .claude/ .github/prompts/ .github/pull_request_template.md .cursor/commands/ .codex/prompts/ .windsurf/ .zed/AGENT.md .agents/ .agent/ local-docs/'

strip_blocks() {
  awk -v b="$BEGIN" -v e="$END" -v legacy="$1" -v vh="$V1_HEAD" -v vp="$V1_PATS" '
    BEGIN { n = split(vp, a, " "); for (i = 1; i <= n; i++) pat[a[i]] = 1 }
    { lines[NR] = $0 }
    END {
      skip = 0; v1 = 0
      for (i = 1; i <= NR; i++) {
        l = lines[i]
        if (skip) { if (l == e) skip = 0; continue }
        if (l == b) { skip = 1; continue }
        if (legacy == 1 && l == vh) {
          if (out > 0 && kept[out] == "") out--
          v1 = 1; continue
        }
        if (v1) { if (l in pat) continue; v1 = 0 }
        kept[++out] = l
      }
      for (i = 1; i <= out; i++) print kept[i]
    }' "$2"
}

RC=0
for d in "${DIRS[@]+"${DIRS[@]}"}"; do
  common=$(cd "$d" 2>/dev/null && top=$(git rev-parse --show-toplevel 2>/dev/null) && cd "$top" && cd "$(git rev-parse --git-common-dir)" && pwd -P) || {
    echo "sdw-exclude: not a git repo: $d" >&2; RC=4; continue; }
  f="$common/info/exclude"
  has=0
  [ -f "$f" ] && grep -qxF "$BEGIN" "$f" && has=1
  case "$MODE" in
    check)
      if [ "$has" = 1 ]; then echo "ok $f"; else echo "missing $f"; [ "$RC" = 0 ] && RC=1; fi
      continue ;;
  esac
  mkdir -p "$common/info"
  [ -f "$f" ] || : > "$f"
  tmp=$(mktemp "${TMPDIR:-/tmp}/sdw-exclude.XXXXXX") || exit 4
  strip_blocks "$LEGACY" "$f" > "$tmp"
  if [ "$MODE" = write ]; then
    if [ -s "$tmp" ] && [ -n "$(tail -c 1 "$tmp")" ]; then echo >> "$tmp"; fi
    printf '%s\n' "$BLOCK" >> "$tmp"
  fi
  if cmp -s "$tmp" "$f"; then
    action=unchanged
  elif [ "$MODE" = write ]; then
    if [ "$has" = 1 ]; then action=updated; else action=added; fi
  else
    action=removed
  fi
  [ "$action" = unchanged ] || cat "$tmp" > "$f"
  rm -f "$tmp"
  echo "$action $f"
done
exit $RC
